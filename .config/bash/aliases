# TMUX {{{
alias t='tmux'

function tmuxnew () {
  PROJECT_DIRECTORY=$1
  PROJECT_NAME="${PROJECT_NAME:-$PROJECT_DIRECTORY}"

  PROJECT_DIRECTORY="$PROJECT_DIRECTORY" tmux -L $PROJECT_NAME -f ~/.config/tmux/generic.conf a
}
